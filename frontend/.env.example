# Frontend environment variables (Vite).
#
# Copy this file to `.env` and fill in real values. Never commit `.env`.
#   cp .env.example .env
#
# Vite only exposes variables prefixed with `VITE_` to client code, and these
# are inlined into the production bundle at build time — so they must be set in
# the build environment (e.g. Vercel project settings), not just at runtime.

# Supabase project URL, e.g. https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_URL=

# Supabase publishable (anon) key. This is safe to ship to the browser, but it
# must be paired with Row Level Security policies on every table.
VITE_SUPABASE_PUBLISHABLE_KEY=
